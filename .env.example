# ============================================================================
# Archivo de Ejemplo de Variables de Entorno (.env.example)
# IMPORTANTE: NO subir claves reales, contraseñas ni tokens al repositorio Git.
# Copie este archivo como .env y complete sus valores.
# El archivo .gitignore ya bloquea automáticamente cualquier archivo .env.
# ============================================================================

# --- Broker MQTT Mosquitto local ---
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_TOPIC_TELEMETRY=datacenter_andino/sala_servidores/telemetria
MQTT_TOPIC_ALERTS=datacenter_andino/sala_servidores/alertas
MQTT_TOPIC_STATUS=datacenter_andino/sala_servidores/estado_nodo

# --- InfluxDB 2.x local ---
INFLUXDB_URL=http://localhost:8086
INFLUXDB_ORG=DataCenter_Andino_SAC
INFLUXDB_BUCKET=monitoreo_datacenter
INFLUXDB_USERNAME=admin
INFLUXDB_PASSWORD=REEMPLAZAR_CON_SU_CONTRASENA_DE_INFLUXDB
INFLUXDB_TOKEN=REEMPLAZAR_CON_SU_TOKEN_DE_INFLUXDB

# --- Grafana local ---
GRAFANA_URL=http://localhost:3000
GRAFANA_USERNAME=admin
GRAFANA_PASSWORD=REEMPLAZAR_CON_SU_CONTRASENA_DE_GRAFANA
